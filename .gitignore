*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
KasiLink

# Dependency directories must never be committed.
node_modules/
**/node_modules/

# KC local apprenticeship store (manifest is tracked; seeded JSON is local)
kopano-core/.kc/

# GSMB Local Schematics is a private source population. New files enter the
# public Cloud only through an explicit, reviewed selection and force-add.
# Existing tracked public projections remain tracked; this rule does not
# retract their history or hide future changes to those tracked files.
/Schematics/


docs/swarm-ops/logs/KPGS_SEVER_FORENSIC.jsonl

# SQLite database files — ignore binaries, track schema/migrations only
*.db
*.db-journal
*.db-wal
*.db-shm

# Exclude local build artifacts/plugins cloned under hooks
hooks/serena-jetbrains-plugin/
hooks/thunder-client/
