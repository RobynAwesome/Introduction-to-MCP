{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kopanolabs.com/schemas/kpgs-callable-artifact-v1alpha1.json",
  "title": "KPGS Callable Artifact",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "kpgs.kopanolabs/v1alpha1"},
    "kind": {"const": "CallableArtifact"},
    "metadata": {
      "type": "object",
      "required": ["id", "name", "group", "version", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "group": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["LEARNING", "POC", "TEST", "ACTIVE", "HOLD", "DEPRECATED"]},
        "created": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["purpose", "task_mode", "invocation", "identity", "model_deliberation", "workflow", "evidence", "ledger"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "task_mode": {"enum": ["BUILD", "LEARN", "RESEARCH", "AUDIT", "CREATE", "OPERATE", "TEACH", "HYBRID"]},
        "invocation": {"type": "object"},
        "identity": {"type": "object"},
        "model_deliberation": {"type": "object"},
        "semantic_bindings": {"type": "object"},
        "protocols": {"type": "array", "items": {"type": "object"}},
        "skills": {"type": "array", "items": {"type": "object"}},
        "workflow": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "evidence": {"type": "object"},
        "ledger": {"type": "object"},
        "guardrails": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "object"}},
        "adk": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
